{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun node_modules/vite/bin/vite.js",
    "build": "bun node_modules/vite/bin/vite.js build",
    "preview": "bun node_modules/vite/bin/vite.js preview",
    "lint": "bun run lint:oxlint && bun run lint:eslint",
    "lint:oxlint": "bun node_modules/oxlint/bin/oxlint . --fix",
    "lint:eslint": "bun node_modules/eslint/bin/eslint.js . --fix --cache"
  },
  "dependencies": {
    "vue": "^3.5.42",
    "vue-router": "5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.10.0",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "globals": "^17.12.0",
    "oxlint": "~1.82.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
